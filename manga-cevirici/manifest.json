{
  "manifest_version": 3,
  "name": "Manga Çevirici (EN ↔ TR)",
  "version": "0.2.0",
  "description": "Sayfadaki manga görsellerindeki yazıyı okur, Türkçe/İngilizce çevirir ve baloncuğun üstüne yerleştirir.",
  "permissions": ["storage", "contextMenus", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manga Çevirici",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "translate-page": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Sayfadaki mangayı çevir / orijinale dön"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
